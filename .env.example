# Copy to .env (repo root or backend/) and fill in what you use. Never commit .env.

# ---- default provider/model (the Settings page can override at runtime) ----
# claude-cli | codex-cli (subscriptions) | anthropic | openai | gemini | groq | openrouter | ollama | custom | mock
LLM_PROVIDER=mock
LLM_MODEL=
# low | medium | high  (reasoning effort for models that support it)
LLM_EFFORT=medium

# ---- API keys: set only the ones you use ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---- subscriptions instead of API keys: claude-cli | codex-cli ----
# claude-cli uses the Claude Code CLI signed in with your Claude Pro/Max plan (run `claude`, then /login).
# codex-cli uses the Codex CLI signed in with your ChatGPT Plus/Pro plan (run `codex login`).
# API keys above are removed from the CLI's environment so the plan, not an API account, is used.
# Paths are only needed when the CLI is not on PATH.
CLAUDE_CLI_PATH=
CODEX_CLI_PATH=
# seconds per request, and requests at once (plans have usage limits)
CLI_TIMEOUT_S=900
CLI_MAX_CONCURRENCY=2
# let Claude Code read the original PDF itself (Read tool on that one file): better equations, more usage
CLAUDE_CLI_READ_PDF=false

# Groq free plan is ~8K tokens/min: keep true for pacing + small requests; false on a paid plan.
GROQ_FREE_TIER=true

# Ollama (local models). Start ollama with a bigger context: OLLAMA_CONTEXT_LENGTH=32768 ollama serve
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_INPUT_BUDGET_TOKENS=12000

# Any other OpenAI-compatible server (LM Studio, vLLM, Together, DeepSeek, ...)
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_MODEL=

# ---- behaviour ----
# Send the original PDF to providers that read PDFs natively (Anthropic): better equations, more tokens.
USE_NATIVE_PDF=true
# auto = docker if the sandbox image exists, else local subprocess | docker | subprocess | disabled
SANDBOX_BACKEND=auto
SANDBOX_DOCKER_IMAGE=paper2chapter-sandbox
SANDBOX_TIMEOUT_S=10

# DATA_DIR=backend/data   (default)
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=50

# ---- frontend (frontend/.env.local) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
